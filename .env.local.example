# ─────────────────────────────────────────────
# Supabase (get from: supabase start OR Supabase dashboard)
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─────────────────────────────────────────────
# Encryption (AES-256 for Canvas API tokens)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────
ENCRYPTION_SECRET=replace-with-64-char-hex-string

# ─────────────────────────────────────────────
# Super Admin (seeded on first deploy)
# ─────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@amalitech.org

# ─────────────────────────────────────────────
# Database (for direct access / GitHub Actions)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
